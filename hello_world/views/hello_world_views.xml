<odoo>

    <!-- Acción -->
    <record id="action_hello_world" model="ir.actions.act_window">
        <field name="name">Hello World</field>
        <field name="res_model">hello.world</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú raíz -->
    <menuitem id="menu_hello_root" name="Hello World"/>

    <!-- Menú hijo -->
    <menuitem
        id="menu_hello_world"
        name="Messages"
        parent="menu_hello_root"
        action="action_hello_world"
    />

    <!-- Vista lista -->
    <record id="view_hello_world_list" model="ir.ui.view">
        <field name="name">hello.world.list</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_hello_world_form" model="ir.ui.view">
        <field name="name">hello.world.form</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="message"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

